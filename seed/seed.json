{
	"$schema": "https://emdashcms.com/seed.schema.json",
	"version": "1",
	"meta": {
		"name": "2Trust.AI Website",
		"description": "Enterprise AI governance and compliance platform",
		"author": "2Trust.AI"
	},

	"settings": {
		"title": "2Trust.AI",
		"tagline": "The enterprise control plane for LLMs"
	},

	"collections": [
		{
			"slug": "posts",
			"label": "Posts",
			"labelSingular": "Post",
			"supports": ["drafts", "revisions", "search", "seo"],
			"commentsEnabled": false,
			"fields": [
				{
					"slug": "title",
					"label": "Title",
					"type": "string",
					"required": true,
					"searchable": true
				},
				{
					"slug": "featured_image",
					"label": "Featured Image",
					"type": "image"
				},
				{
					"slug": "content",
					"label": "Content",
					"type": "portableText",
					"searchable": true
				},
				{
					"slug": "excerpt",
					"label": "Excerpt",
					"type": "text"
				}
			]
		},
		{
			"slug": "pages",
			"label": "Pages",
			"labelSingular": "Page",
			"supports": ["drafts", "revisions", "search"],
			"fields": [
				{
					"slug": "title",
					"label": "Title",
					"type": "string",
					"required": true,
					"searchable": true
				},
				{
					"slug": "content",
					"label": "Content",
					"type": "portableText",
					"searchable": true
				}
			]
		}
	],

	"taxonomies": [
		{
			"name": "category",
			"label": "Categories",
			"labelSingular": "Category",
			"hierarchical": true,
			"collections": ["posts"],
			"terms": [
				{ "slug": "ai-governance", "label": "AI Governance" },
				{ "slug": "compliance", "label": "Compliance" },
				{ "slug": "product-news", "label": "Product News" },
				{ "slug": "research", "label": "Research" }
			]
		},
		{
			"name": "tag",
			"label": "Tags",
			"labelSingular": "Tag",
			"hierarchical": false,
			"collections": ["posts"],
			"terms": [
				{ "slug": "eu-ai-act", "label": "EU AI Act" },
				{ "slug": "nist-ai-rmf", "label": "NIST AI RMF" },
				{ "slug": "prompt-injection", "label": "Prompt Injection" },
				{ "slug": "enterprise-ai", "label": "Enterprise AI" },
				{ "slug": "llm-security", "label": "LLM Security" },
				{ "slug": "hipaa", "label": "HIPAA" }
			]
		}
	],

	"bylines": [
		{
			"id": "byline-2trust-editorial",
			"slug": "2trust-editorial",
			"displayName": "2Trust.AI Editorial"
		},
		{
			"id": "byline-guest",
			"slug": "guest-contributor",
			"displayName": "Guest Contributor",
			"isGuest": true
		}
	],

	"menus": [
		{
			"name": "primary",
			"label": "Primary Navigation",
			"items": [
				{ "type": "custom", "label": "Platform", "url": "/platform" },
				{ "type": "custom", "label": "Solutions", "url": "/solutions" },
				{ "type": "custom", "label": "Governance", "url": "/governance" },
				{ "type": "custom", "label": "Developers", "url": "/developers" },
				{ "type": "custom", "label": "Pricing", "url": "/pricing" },
				{ "type": "custom", "label": "About", "url": "/about" }
			]
		}
	],

	"widgetAreas": [
		{
			"name": "sidebar",
			"label": "Blog Sidebar",
			"description": "Widget area displayed on single post pages",
			"widgets": [
				{
					"type": "component",
					"componentId": "core:search",
					"title": "Search"
				},
				{
					"type": "component",
					"componentId": "core:categories",
					"title": "Categories"
				},
				{
					"type": "component",
					"componentId": "core:recent-posts",
					"title": "Recent Posts",
					"settings": {
						"count": 5,
						"showDate": true
					}
				}
			]
		}
	],

	"content": {
		"pages": [],
		"posts": []
	}
}
