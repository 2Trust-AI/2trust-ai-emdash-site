---
import { getSiteSettings, getMenu } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { Font } from "astro:assets";
import { resolveBlogSiteIdentity } from "../utils/site-identity";
import "../styles/theme.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	type?: "website" | "article";
	publishedTime?: string | null;
	modifiedTime?: string | null;
	author?: string | null;
	content?: { collection: string; id: string; slug?: string | null };
}

const {
	title,
	pageTitle,
	description,
	image,
	canonical,
	robots,
	type = "website",
	publishedTime,
	modifiedTime,
	author,
	content,
} = Astro.props;

const { siteTitle } = resolveBlogSiteIdentity(await getSiteSettings());
const fullTitle = title.includes(siteTitle) ? title : `${title} — ${siteTitle}`;

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: type,
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description,
	canonical,
	image,
	content,
	seo: { ogImage: image, robots },
	articleMeta: { publishedTime, modifiedTime, author },
	siteName: siteTitle,
});

const isLoggedIn = !!Astro.locals.user;
const path = new URL(Astro.request.url).pathname;
const primaryMenu = await getMenu("primary");
const navLinks: Array<[string, string]> = primaryMenu?.items.map(
	(item) => [item.url, item.label] as [string, string]
) ?? [];

function isActive(href: string) {
	if (href === "/") return path === "/";
	return path === href || path.startsWith(href + "/");
}
---

<!doctype html>
<html lang="en" data-theme="light">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<Font cssVariable="--font-display" preload />
		<Font cssVariable="--font-body" preload />
		<Font cssVariable="--font-mono" />
		<title>{fullTitle}</title>
		{description && <meta name="description" content={description} />}
		<!-- Google Tag Manager -->
		<script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-W8KTRGCX');</script>
		<!-- End Google Tag Manager -->
		<EmDashHead page={pageCtx} />
		<script is:inline>
			(function () {
				var c = document.cookie;
				var i = c.indexOf("theme=");
				var theme = i >= 0 ? c.slice(i + 6).split(";")[0] : null;
				var dark =
					theme === "dark" ||
					((theme === null || theme === "system") &&
						window.matchMedia("(prefers-color-scheme: dark)").matches);
				document.documentElement.setAttribute("data-theme", dark ? "dark" : "light");
				document.documentElement.classList.toggle("dark", dark);
			})();
		</script>
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<!-- Google Tag Manager (noscript) -->
		<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-W8KTRGCX" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
		<!-- End Google Tag Manager (noscript) -->
		<div class="page">
			<header class="site-nav">
				<div class="container nav-inner">
					<a class="logo" href="/">
						<span class="logo-mark">
							<svg viewBox="0 0 24 24" fill="none">
								<path
									d="M12 3L19 6.5V12.5C19 16.5 16 19.5 12 20.5C8 19.5 5 16.5 5 12.5V6.5L12 3Z"
									stroke="currentColor"
									stroke-width="1.6"
									stroke-linejoin="round"
									fill="none"
								></path>
								<path
									d="M9 12L11 14L15 10"
									stroke="currentColor"
									stroke-width="1.8"
									stroke-linecap="round"
									stroke-linejoin="round"
								></path>
							</svg>
						</span>
						<span>2Trust<span class="logo-accent">.AI</span></span>
					</a>
					<nav class="nav-links" id="navLinks">
						{
							navLinks.map(([href, label]) => (
								<a
									href={href}
									class="nav-link"
									aria-current={isActive(href) ? "page" : undefined}
								>
									{label}
								</a>
							))
						}
						<a href="/contact" class="btn btn-primary nav-mobile-cta" style="margin-top:12px;justify-content:center;">
							Book demo
							<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><path d="M3 8h10M9 4l4 4-4 4"></path></svg>
						</a>
					</nav>
					<div class="nav-cta">
						<a href="/contact" class="btn btn-quiet" style="font-size:13px;">Sign in</a>
						<a href="/contact" class="btn btn-primary">
							Book demo
							<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><path d="M3 8h10M9 4l4 4-4 4"></path></svg>
						</a>
						{isLoggedIn && <a href="/_emdash/admin" class="nav-admin-link">Admin</a>}
						<button class="btn nav-mobile-btn" id="navToggle" aria-label="Menu" aria-expanded="false">
							<svg id="navIconOpen" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" width="16" height="16"><path d="M3 6h14"></path><path d="M3 10h14"></path><path d="M3 14h14"></path></svg>
							<svg id="navIconClose" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" width="16" height="16" style="display:none;"><path d="M5 5l10 10M15 5L5 15"></path></svg>
						</button>
					</div>
				</div>
			</header>

			<main style="flex:1;">
				<slot />
			</main>

			<footer class="site-footer">
				<div class="container">
					<div class="footer-grid">
						<div>
							<a class="logo" href="/">
								<span class="logo-mark">
									<svg viewBox="0 0 24 24" fill="none">
										<path
											d="M12 3L19 6.5V12.5C19 16.5 16 19.5 12 20.5C8 19.5 5 16.5 5 12.5V6.5L12 3Z"
											stroke="currentColor"
											stroke-width="1.6"
											stroke-linejoin="round"
											fill="none"
										></path>
										<path
											d="M9 12L11 14L15 10"
											stroke="currentColor"
											stroke-width="1.8"
											stroke-linecap="round"
											stroke-linejoin="round"
										></path>
									</svg>
								</span>
								<span>2Trust<span class="logo-accent">.AI</span></span>
							</a>
							<p style="color:var(--ink-muted);font-size:13.5px;margin-top:14px;max-width:280px;">
								The enterprise control plane between your employees, your customers, your data, and Large Language Models.
							</p>
						</div>
						<div class="footer-col">
							<h5>Platform</h5>
							<ul>
								<li><a href="/platform">Safety & Trust Layer</a></li>
								<li><a href="/governance">Governance Wizards</a></li>
								<li><a href="/platform">Model Abstraction</a></li>
								<li><a href="/platform">Document Workbench</a></li>
								<li><a href="/developers">REST API</a></li>
								<li><a href="/developers">MCP Integration</a></li>
							</ul>
						</div>
						<div class="footer-col">
							<h5>Solutions</h5>
							<ul>
								<li><a href="/solutions/financial-services">Financial services</a></li>
								<li><a href="/solutions/healthcare">Healthcare</a></li>
								<li><a href="/solutions/public-sector">Public Sector & Education</a></li>
								<li><a href="/solutions/legal">Legal</a></li>
								<li><a href="/solutions/enterprise-it">Enterprise IT</a></li>
								<li><a href="/solutions/pharma">Pharma & Life Sciences</a></li>
							</ul>
						</div>
						<div class="footer-col">
							<h5>Company</h5>
							<ul>
								<li><a href="/about">About</a></li>
								<li><a href="/about">Customers</a></li>
								<li><a href="/about">Trust center</a></li>
								<li><a href="/about">Careers</a></li>
								<li><a href="/about">Press</a></li>
							</ul>
						</div>
						<div class="footer-col">
							<h5>Resources</h5>
							<ul>
								<li><a href="/developers">Docs</a></li>
								<li><a href="/governance">EU AI Act guide</a></li>
								<li><a href="/governance">Prompt-injection research</a></li>
								<li><a href="/about">Whitepapers</a></li>
								<li><a href="/about">Changelog</a></li>
							</ul>
						</div>
					</div>
					<div class="footer-bottom">
						<span>© 2026 2Trust.AI, Inc. &nbsp;·&nbsp; All rights reserved. &nbsp;·&nbsp; <a href="/privacy-policy" style="color:inherit;text-decoration:none;opacity:0.7;">Privacy Policy</a> &nbsp;·&nbsp; <a href="/terms" style="color:inherit;text-decoration:none;opacity:0.7;">Terms</a></span>
						<span style="display:inline-flex;gap:14px;align-items:center;">
							<span>SYS // STATUS: OPERATIONAL</span>
							<span class="footer-theme" role="group" aria-label="Theme">
								<button type="button" data-theme="light" aria-label="Light mode" title="Light">
									<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path></svg>
								</button>
								<button type="button" data-theme="dark" aria-label="Dark mode" title="Dark">
									<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
								</button>
								<button type="button" data-theme="system" aria-label="Match system" title="System">
									<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="14" rx="2"></rect><path d="M8 20h8M12 18v2"></path></svg>
								</button>
							</span>
						</span>
					</div>
				</div>
			</footer>
		</div>
		<EmDashBodyEnd page={pageCtx} />

		<script>
			// Mobile nav toggle
			const toggle = document.getElementById("navToggle");
			const links = document.getElementById("navLinks");
			const iconOpen = document.getElementById("navIconOpen");
			const iconClose = document.getElementById("navIconClose");
			toggle?.addEventListener("click", () => {
				const open = links?.getAttribute("data-mobile-open") === "true";
				const next = !open;
				links?.setAttribute("data-mobile-open", String(next));
				toggle.setAttribute("aria-expanded", String(next));
				if (iconOpen) iconOpen.style.display = next ? "none" : "";
				if (iconClose) iconClose.style.display = next ? "" : "none";
			});

			// Theme switcher — three states: light | dark | system
			const root = document.documentElement;
			const themeBtns = document.querySelectorAll<HTMLButtonElement>(".footer-theme button");
			const mql = window.matchMedia("(prefers-color-scheme: dark)");

			function setCookie(name: string, value: string) {
				const secure = location.protocol === "https:" ? "; Secure" : "";
				document.cookie = `${name}=${value}; path=/; max-age=31536000; SameSite=Lax${secure}`;
			}

			function paint(theme: string) {
				const dark =
					theme === "dark" || (theme === "system" && mql.matches);
				root.setAttribute("data-theme", dark ? "dark" : "light");
				root.classList.toggle("dark", dark);
				themeBtns.forEach((b) => b.classList.toggle("active", b.dataset.theme === theme));
			}

			function getStored(): "light" | "dark" | "system" {
				const m = document.cookie.match(/theme=([^;]+)/);
				const v = m?.[1];
				return v === "light" || v === "dark" || v === "system" ? v : "system";
			}

			paint(getStored());

			themeBtns.forEach((b) =>
				b.addEventListener("click", () => {
					const theme = b.dataset.theme || "system";
					setCookie("theme", theme);
					paint(theme);
				})
			);

			// React to OS changes when in "system" mode
			mql.addEventListener("change", () => {
				if (getStored() === "system") paint("system");
			});
		</script>
	</body>
</html>
