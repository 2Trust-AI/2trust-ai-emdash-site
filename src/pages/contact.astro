---
import Base from "../layouts/Base.astro";

const success = Astro.url.searchParams.get("success") === "1";
const error = Astro.url.searchParams.get("error");
---

<Base
	title="Book a demo — 2Trust.AI"
	description="Walk through the platform with a 2Trust solutions engineer. Typical pilot: 2–4 weeks."
>
	<section class="section">
		<div class="container" style="max-width:720px;">
			<div class="eyebrow"><span class="dot"></span> Contact</div>
			<h1 class="h-1" style="margin:18px 0 14px;">Book a demo.</h1>
			<p class="lede">
				Walk through the platform with a 2Trust solutions engineer. We'll map one existing LLM integration onto <span class="mono">/api/v1/ai/infer</span> and stand up a governed DocumentCollection against a representative corpus. Typical pilot: 2–4 weeks.
			</p>

			{success ? (
				<div class="card" style="margin-top:32px;display:flex;flex-direction:column;gap:12px;align-items:flex-start;">
					<div style="display:flex;align-items:center;gap:10px;">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="22" height="22" style="color:var(--accent);flex-shrink:0;"><path d="M12 2l8 4v6c0 5-3.5 9-8 10-4.5-1-8-5-8-10V6l8-4z"></path><path d="M9 12l2 2 4-4"></path></svg>
						<strong>Request received.</strong>
					</div>
					<p style="color:var(--ink-muted);margin:0;">We'll be in touch within one business day to schedule your demo.</p>
					<a href="/" class="btn btn-quiet" style="margin-top:4px;">Back to home</a>
				</div>
			) : (
				<form
					class="card"
					style="margin-top:32px;display:grid;gap:16px;"
					method="post"
					action="/_emdash/forms/submit"
					novalidate
				>
					<input type="hidden" name="formId" value="demo-request" />
					{error && (
						<p style="color:#e53e3e;font-size:14px;margin:0;">Something went wrong. Please try again.</p>
					)}
					<div class="pb-field" style="margin:0;">
						<label>Work email</label>
						<input class="pb-input" type="email" name="work_email" required placeholder="name@company.com" />
					</div>
					<div class="pb-field" style="margin:0;">
						<label>Company</label>
						<input class="pb-input" type="text" name="company" required placeholder="Meridian Bank" />
					</div>
					<div class="pb-field" style="margin:0;">
						<label>What are you governing?</label>
						<textarea class="pb-input" name="what_are_you_governing" rows="4" placeholder="Model, deployment, audience, any regulators involved."></textarea>
					</div>
					<div style="display:flex;gap:10px;align-items:center;">
						<button type="submit" class="btn btn-primary btn-lg">
							Request demo
							<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><path d="M3 8h10M9 4l4 4-4 4"></path></svg>
						</button>
						<span class="small">No trial account required.</span>
					</div>
				</form>
			)}
		</div>
	</section>
</Base>
