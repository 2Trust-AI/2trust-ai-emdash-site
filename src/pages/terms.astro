<style>
	.policy-body {
		color: var(--ink);
		font-size: 15px;
		line-height: 1.75;
	}

	.policy-body h2 {
		font-size: 18px;
		font-weight: 700;
		margin: 48px 0 12px;
		color: var(--ink);
		border-top: 1px solid var(--border);
		padding-top: 32px;
	}

	.policy-body h2:first-child {
		border-top: none;
		padding-top: 0;
		margin-top: 0;
	}

	.policy-body p {
		margin: 0 0 14px;
		color: var(--ink-muted);
	}

	.policy-body ul {
		margin: 0 0 14px 0;
		padding-left: 22px;
		color: var(--ink-muted);
	}

	.policy-body ul li {
		margin-bottom: 8px;
	}

	.policy-body a {
		color: var(--accent);
		text-decoration: none;
	}

	.policy-body a:hover {
		text-decoration: underline;
	}
</style>
