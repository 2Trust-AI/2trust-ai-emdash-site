{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "2trust-ai-emdash-site",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	// Workers Logs. Off by default, which meant this worker produced NO logs at
	// all — no way to see an error after the fact, and nothing for `wrangler tail`
	// to stream. Every other worker we operate has this on.
	"observability": {
		"enabled": true,
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "2trust-ai-emdash-site",
			// Run `wrangler d1 create my-emdash-site` and paste the real ID here for deploy
			"database_id": "9bddc95a-f74e-4ef5-9215-87ceb530160e",
		},
		{
			// LABS-95 traffic log (table page_views). Separate from the CMS database so the
			// internal dashboard can get a read binding to logs without seeing CMS data.
			// Apply migrations before deploying the Worker:
			//   npx wrangler d1 migrations apply 2trust-ai-site-logs --remote
			"binding": "LOGS",
			"database_name": "2trust-ai-site-logs",
			"database_id": "83a40191-0f56-474c-b47d-9d0311179b37",
			"migrations_dir": "migrations-logs",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "2trust-ai-emdash-media","preview_bucket_name": "2trust-ai-emdash-media",
		},
	],
	// Worker Loader for plugin sandboxing
	"worker_loaders": [
		{
			"binding": "LOADER",
		},
	],
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "75dbe2ed3f884d0987cfb996af814428",
		},
	],
	"routes": [
		{ "pattern": "2trust.ai", "custom_domain": true },
		{ "pattern": "www.2trust.ai", "custom_domain": true },
	],
}
